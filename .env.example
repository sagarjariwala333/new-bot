# Template for the environment variables (Railway: Project > Service > Variables).
# For a local run, copy this file to `.env`. NEVER commit `.env` or paste real secrets into this file.
#
# Every variable below that holds a secret is to be typed in by the OWNER, in the
# OWNER'S OWN Railway account. This package contains no keys, no passwords and no
# trading settings. Trading settings are typed into the dashboard
# ("Default Settings" tab) after deployment - never into environment variables.

# --- Required on Railway ----------------------------------------------------
# Must be 0.0.0.0 on Railway so the platform can reach the app (run.py defaults to
# 127.0.0.1, which Railway cannot reach). PORT is injected by Railway itself.
HOST=0.0.0.0
# Mount a Railway Volume at /data and point DATA_DIR at it. This folder holds the
# encrypted exchange keys, the dashboard login, the saved settings, the ledger and
# the trade state. Without a volume, everything is lost on every redeploy.
DATA_DIR=/data
# On Railway the app REFUSES TO START TRADING if DATA_DIR is not on the attached Volume (the tracker's
# all-time high and shadow state would be lost on every redeploy). Do not add a variable to bypass this
# on a live deployment.
# Railway serves the dashboard over HTTPS, so cookies must be Secure.
COOKIE_SECURE=true

# --- Dashboard login (owner types these) ---------------------------------------
# Seeds the single admin account on FIRST START only. If DASHBOARD_PASSWORD is left
# blank, a random one is printed ONCE in the deploy log - anyone who can read the
# log would see it, so the owner should set it here and change it after login.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# --- Encryption key for the saved exchange API keys (owner generates + keeps a copy) --
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If this key is lost, the saved API keys cannot be decrypted (re-enter them).
MASTER_ENC_KEY=

# --- Telegram alerts (optional, owner's own bot) ------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email fallback (optional) -------------------------------------------------
# SMTP login for the fallback alert email and password-reset codes. The destination
# address is typed into the dashboard (Default Settings tab); ALERT_EMAIL_TO is only
# a fallback if that dashboard field is blank. Leave all blank to disable email.
# For Gmail use an App Password, not the normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_EMAIL_TO=
